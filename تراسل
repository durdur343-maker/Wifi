<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NetFiles</title>
<style>
:root{--bg:#eef3fb;--card:#fff;--line:#dbe4f2;--tx:#1c2a3f;--mut:#6b7b93;--pri:#1565d8;--soft:#e3eefc;--ok:#22c55e;--bad:#e5484d}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1624;--card:#18223a;--line:#2a3856;--tx:#e8eefb;--mut:#93a3c0;--pri:#4b8df8;--soft:#1f2f52}}
:root[data-theme="dark"]{--bg:#0f1624;--card:#18223a;--line:#2a3856;--tx:#e8eefb;--mut:#93a3c0;--pri:#4b8df8;--soft:#1f2f52}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit;margin:0;font-family:"Segoe UI",Tahoma,Arial,sans-serif}
html,body{height:100%;background:var(--bg);color:var(--tx);font-size:15px}
.app{display:flex;flex-direction:column;height:100%;max-width:640px;margin:auto}
header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px}
header h1{font-size:19px}header small{display:block;color:var(--mut);font-size:11px}
.pill{background:var(--soft);color:var(--pri);border-radius:20px;padding:3px 12px;font-size:12px}
#content{flex:1;overflow:auto;padding:4px 14px 14px}
nav{display:flex;border-top:1px solid var(--line);background:var(--card)}
nav button{flex:1;border:0;background:none;color:var(--mut);padding:11px 4px;font-size:12px;cursor:pointer}
nav button.on{color:var(--pri);font-weight:700}nav span{display:block;font-size:20px}
button{font-size:14px;border:1px solid var(--line);background:var(--card);color:var(--tx);border-radius:12px;padding:10px 14px;cursor:pointer}
button.pri{background:var(--pri);border-color:var(--pri);color:#fff}
button.ghost{background:none}button.wide{width:100%}
.row2{display:flex;gap:8px;margin:8px 0}.row2>*{flex:1}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;margin-top:10px}
.item{display:flex;align-items:center;gap:10px}.item .g{flex:1;min-width:0}
.item b{display:block;word-break:break-word}.item small{color:var(--mut);font-size:12px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--ok);flex:none}.dot.off{background:var(--mut)}
.mut{color:var(--mut);font-size:13px;line-height:1.7}
.bar{height:6px;background:var(--line);border-radius:6px;margin-top:6px;overflow:hidden}.bar i{display:block;height:100%;background:var(--pri)}
input,textarea{width:100%;font-size:14px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--tx);outline:none}
textarea{height:110px;direction:ltr;font-family:monospace;font-size:11px;word-break:break-all}
